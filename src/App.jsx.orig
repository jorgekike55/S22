        </section>
      </main>

      <footer className="site-footer">
        <a className="brand footer-brand" href="#inicio">
          <span className="brand-mark" aria-hidden="true">DH</span>
          <span>Dulce Horno<small>REPOSTERÍA ARTESANAL</small></span>
